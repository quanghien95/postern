# Postern MCP server config. The MCP client (e.g. Claude Code) passes these in
# its server "env" block; this file is only a reference. NEVER commit a real token.

# The Postern mailbox API origin (the inbound Worker).
POSTERN_API_URL=https://your-postern-api.workers.dev

# Bearer for read tools (search/list/get/thread/attachment). Required.
# Prefer a per-identity registry token with scopes including "read" (#544) so
# this MCP process only sees that mailbox. An estate POSTERN_API_TOKEN / _READ
# remains estate-wide -- do not share it across people.
POSTERN_API_TOKEN=

# OPTIONAL, OPT-IN, MUTATING: separate send Bearer (#85). When set, registers
# mailbox_send / mailbox_reply and uses THIS token for them. Prefer a registry
# token bound to the sender. Leave unset for read-only (the default).
# POSTERN_SEND_TOKEN=

# OPTIONAL: set to 1 to register send tools using POSTERN_API_TOKEN as the send
# credential (for one registry token with scopes ["read","send"]). Do not use
# with an estate both-token unless you intend that process to send as the estate.
# POSTERN_MCP_SEND=1

# Optional: per-request timeout in milliseconds (default 15000).
# POSTERN_API_TIMEOUT_MS=15000

# Optional: max bytes mailbox_get_attachment will return (default 5 MiB).
# Larger attachments are refused with a clear error, never truncated.
# POSTERN_MCP_MAX_ATTACHMENT_BYTES=5242880
